# =============================================================================
# MCP Server Configuration
# =============================================================================

# API Key Authentication Configuration
# The HTTP header name that clients must use to send the API key
# Default: x-api-key (clients send: "x-api-key: your-secret-key")
MCP_MASTER_API_KEY_NAME=x-api-key

# The master API key for authenticating MCP client requests
# IMPORTANT: 
# - Leave empty or comment out for development mode (no authentication)
# - Set to a strong, unique key (min 32 characters) for production
# - This key must be included in client requests via the header specified above
# Example: MCP_MASTER_API_KEY=your-super-secret-production-key-here-32chars-minimum
MCP_MASTER_API_KEY=default-secret-key

# Request Correlation ID Configuration
# The HTTP header name for correlation IDs to track requests across logs
# Clients can send this header to correlate logs for debugging
# If not provided by client, a UUID will be auto-generated
# Default: x-correlation-id
CORRELATION_ID_NAME=x-correlation-id

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level for the application
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Detailed information for development and troubleshooting
# - INFO: General information about server operations (recommended for production)
# - WARNING: Warning messages about potential issues
# - ERROR: Error messages for failed operations
# - CRITICAL: Critical errors that may cause server shutdown
LOG_LEVEL=DEBUG

# Optional log file path for persistent logging
# Leave empty to log only to console/stdout
# Example: LOG_FILE=/var/log/mcp-server/server.log
# Note: Ensure the directory exists and has write permissions
LOG_FILE=

# =============================================================================
# Server Configuration
# =============================================================================

# Host address for the MCP server to bind to
# - localhost: Only accessible from local machine (development)
# - 0.0.0.0: Accessible from any network interface (production)
# - Specific IP: Bind to a specific network interface
SERVER_HOST=localhost

# Port number for the main MCP server
# Default: 8000
# Ensure this port is available and not blocked by firewall
SERVER_PORT=8000

# Port number for the health check server
# Default: 8001
# Used for monitoring server health and status
# Should be different from SERVER_PORT
HEALTH_CHECK_PORT=8001

# =============================================================================
# Base Path Configuration
# =============================================================================

# Base URL path for MCP protocol endpoints
# This determines the URL structure for your MCP server:
# - Streamable HTTP endpoint: http://host:port{MCP_BASE_PATH}/mcp/
# Default: /product-a
MCP_BASE_PATH=/product-a

